{
  "name": "agenticx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:golden": "node --import tsx tests/agentic/generate-golden.ts",
    "verify:esm": "node --import tsx scripts/verify-esm.ts",
    "verify-run": "npm run dev -- verify-run",
    "dev": "node --import tsx scripts/agentic.ts",
    "run-new": "node --import tsx scripts/scaffold-run.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/scripts/agentic.js",
    "doctor:native": "npm ls rollup @rollup/rollup-linux-x64-gnu @rollup/rollup-win32-x64-msvc"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.55.1",
    "@types/node": "^20.11.30",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  }
}
