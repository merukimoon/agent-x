{
  "name": "agenticx",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "bin": {
    "agentic": "./bin/agentic.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm exec vitest run --config vitest.config.js",
    "test:unit": "pnpm exec vitest run --config vitest.unit.config.js",
    "test:unit:coverage": "pnpm exec vitest run --config vitest.unit.config.js --coverage",
    "test:integration": "pnpm exec vitest run --config vitest.integration.config.js",
    "test:all": "pnpm exec vitest run --config vitest.config.js",
    "test:coverage": "pnpm exec vitest run --config vitest.unit.config.js --coverage",
    "test:watch": "pnpm exec vitest --config vitest.config.js",
    "test:golden": "node --import tsx tests/agentic/generate-golden.ts",
    "verify:esm": "node --import tsx scripts/verify-esm.ts",
    "verify-run": "pnpm run dev verify-run",
    "dev": "node --import tsx scripts/agentic.ts",
    "run-new": "node --import tsx scripts/scaffold-run.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/scripts/agentic.js",
    "doctor:native": "pnpm ls rollup @rollup/rollup-linux-x64-gnu @rollup/rollup-win32-x64-msvc"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.55.1",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  }
}