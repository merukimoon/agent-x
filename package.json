{
  "name": "agentsquad-framework",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "node tests/agentic/generate-golden.js",
    "verify:esm": "node scripts/verify-esm.js",
    "dev": "tsx scripts/agentic.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/scripts/agentic.js"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.55.1",
    "@types/node": "^20.11.30",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  }
}
