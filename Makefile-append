
.PHONY: planner

planner:
	@set -eu; \
	GOAL="$${GOAL:-}"; \
	CONTEXT="$${CONTEXT:-repo uses /docs folder}"; \
	RUN="$${RUN:-}"; \
	if [ -z "$$GOAL" ]; then \
		echo "ERROR: GOAL is required. Example: make planner GOAL=\"Add new feature\""; \
		exit 2; \
	fi; \
	RUN_FLAG=""; \
	if [ ! -z "$$RUN" ]; then \
		RUN_FLAG="--run $$RUN"; \
	fi; \
	node scripts/agentic.js planner --goal "$$GOAL" --context "$$CONTEXT" $$RUN_FLAG
